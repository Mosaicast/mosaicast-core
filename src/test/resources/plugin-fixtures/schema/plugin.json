{
  "id": "schema",
  "version": "1.0.0",
  "platformApi": "0.8.0",
  "name": "Schema Fixture",
  "backend": {
    "basePath": "/api/plugins/schema",
    "extensions": [
      "dev.mosaicast.plugin.fixture.FixturePlugin"
    ]
  },
  "frontend": {
    "entry": "fixture.js",
    "elements": [
      "fixture-card"
    ]
  },
  "slots": [
    {
      "scope": "site",
      "element": "fixture-card",
      "placement": "main",
      "visibleTo": "anonymous"
    }
  ],
  "storage": "schema",
  "data": {
    "readableBy": "anonymous",
    "writableBy": "podcaster"
  },
  "config": {}
}
