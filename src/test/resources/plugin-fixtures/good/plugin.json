{
  "id": "good",
  "version": "1.0.0",
  "platformApi": "0.3.0",
  "name": "Good Fixture",
  "backend": {
    "basePath": "/api/plugins/good",
    "extensions": [
      "dev.mosaicast.plugin.fixture.FixturePlugin",
      "dev.mosaicast.plugin.fixture.FixtureShareMetadata",
      "dev.mosaicast.plugin.fixture.FixtureSitemap"
    ]
  },
  "frontend": {
    "entry": "fixture.js",
    "elements": ["fixture-card", "fixture-page"]
  },
  "slots": [
    { "scope": "episode", "element": "fixture-card", "placement": "main", "visibleTo": "anonymous", "order": 100 },
    { "scope": "site", "element": "fixture-admin", "placement": "sidebar", "visibleTo": "podcaster" },
    { "scope": "site", "element": "fixture-page", "placement": "page", "visibleTo": "anonymous" }
  ],
  "storage": "doc",
  "config": {
    "refreshIntervalMinutes": { "type": "number", "default": 30, "editableBy": "podcaster" },
    "apiToken": { "type": "string", "default": "", "editableBy": "admin" }
  },
  "consent": {
    "categories": ["analytics", "necessary"],
    "externalSources": ["https://plausible.example", "bad;host"]
  }
}
