{
  "id": "good",
  "version": "1.0.0",
  "platformApi": "0.9.0",
  "name": "Good Fixture",
  "license": "Apache-2.0",
  "author": "The Mosaicast Authors",
  "homepage": "https://fixture.example/good",
  "attribution": "https://fixture.example/thanks",
  "backend": {
    "basePath": "/api/plugins/good",
    "extensions": [
      "dev.mosaicast.plugin.fixture.FixturePlugin",
      "dev.mosaicast.plugin.fixture.FixtureShareMetadata",
      "dev.mosaicast.plugin.fixture.FixtureSitemap",
      "dev.mosaicast.plugin.fixture.FixtureSearch",
      "dev.mosaicast.plugin.fixture.FixtureUserData"
    ]
  },
  "frontend": {
    "entry": "fixture.js",
    "elements": [
      "fixture-card",
      "fixture-page"
    ]
  },
  "slots": [
    {
      "scope": "episode",
      "element": "fixture-card",
      "placement": "main",
      "visibleTo": "anonymous",
      "order": 100
    },
    {
      "scope": "site",
      "element": "fixture-admin",
      "placement": "sidebar",
      "visibleTo": "podcaster"
    },
    {
      "scope": "site",
      "element": "fixture-page",
      "placement": "page",
      "visibleTo": "anonymous"
    }
  ],
  "nav": [
    {
      "path": "",
      "label": "Good Fixture",
      "icon": "book"
    },
    {
      "path": "_secret",
      "label": "Staff only",
      "visibleTo": "podcaster"
    }
  ],
  "storage": "doc",
  "data": {
    "readableBy": "anonymous",
    "writableBy": "podcaster",
    "backendOwned": [
      "episode-count",
      "agg:*",
      "erased:*"
    ]
  },
  "config": {
    "refreshIntervalMinutes": {
      "type": "number",
      "default": 30,
      "editableBy": "podcaster"
    },
    "apiToken": {
      "type": "string",
      "default": "",
      "editableBy": "admin"
    },
    "failErasure": {
      "type": "boolean",
      "default": false,
      "editableBy": "admin"
    }
  },
  "consent": {
    "services": [
      {
        "id": "stats",
        "name": "Fixture Analytics",
        "provider": "Fixture Analytics Ltd.",
        "category": "analytics",
        "privacyUrl": "https://plausible.example/privacy",
        "hosts": [
          "https://plausible.example"
        ],
        "thirdCountryTransfer": false,
        "storage": [
          {
            "name": "fixture_id",
            "type": "cookie",
            "purpose": "counts a visit once",
            "duration": "24 hours"
          }
        ]
      },
      {
        "id": "session-keeper",
        "name": "Fixture Session Keeper",
        "provider": "The Mosaicast Authors",
        "category": "necessary",
        "privacyUrl": "https://necessary.example/privacy",
        "hosts": [
          "https://necessary.example"
        ],
        "thirdCountryTransfer": false,
        "storage": []
      }
    ]
  }
}
