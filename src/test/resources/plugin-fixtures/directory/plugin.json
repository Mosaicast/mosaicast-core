{
  "id": "directory",
  "version": "1.0.0",
  "platformApi": "0.15.0",
  "name": "Directory Fixture",
  "frontend": {
    "entry": "fixture.js",
    "elements": [
      "directory-card"
    ]
  },
  "slots": [
    {
      "scope": "site",
      "element": "directory-card",
      "placement": "sidebar",
      "visibleTo": "anonymous"
    }
  ],
  "storage": "doc",
  "data": {
    "readableBy": "anonymous",
    "writableBy": "podcaster"
  },
  "identity": {
    "resolvesUsers": true
  },
  "notifications": {
    "sends": true,
    "perUserPerDay": 5
  }
}
