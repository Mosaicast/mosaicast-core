{
  "id": "keyfloors",
  "version": "1.0.0",
  "platformApi": "0.19.0",
  "name": "Key Floors Fixture",
  "backend": {
    "basePath": "/api/plugins/keyfloors",
    "extensions": [
      "dev.mosaicast.plugin.fixture.FixturePlugin"
    ]
  },
  "frontend": {
    "entry": "fixture.js",
    "elements": [
      "fixture-card"
    ]
  },
  "slots": [
    {
      "scope": "site",
      "element": "fixture-card",
      "placement": "main",
      "visibleTo": "anonymous"
    }
  ],
  "storage": "doc",
  "data": {
    "readableBy": "anonymous",
    "writableBy": "podcaster",
    "backendOwned": ["kf:stats"],
    "keyFloors": [
      { "keys": ["kf:import:*", "kf:staged:*"], "readableBy": "podcaster" },
      { "keys": ["kf:bundles", "kf:stats"], "writableBy": "admin" },
      { "keys": ["kf:import:secret"], "readableBy": "admin" }
    ]
  },
  "config": {}
}
