{
  "id": "broken",
  "version": "1.0.0",
  "platformApi": "0.2.0",
  "name": "Incompatible Fixture",
  "backend": {
    "basePath": "/api/plugins/broken",
    "extensions": [
      "dev.mosaicast.plugin.fixture.FixturePlugin"
    ]
  },
  "frontend": {
    "entry": "fixture.js",
