{
  "id": "blobs",
  "version": "1.0.0",
  "platformApi": "0.9.0",
  "name": "Blob Fixture",
  "backend": {
    "basePath": "/api/plugins/blobs",
    "extensions": [
      "dev.mosaicast.plugin.fixture.FixturePlugin"
    ]
  },
  "frontend": {
    "entry": "fixture.js",
    "elements": [
      "fixture-card"
    ]
  },
  "slots": [
    {
      "scope": "episode",
      "element": "fixture-card",
      "placement": "main",
      "visibleTo": "anonymous",
      "order": 100
    }
  ],
  "storage": "doc",
  "data": {
    "readableBy": "anonymous",
    "writableBy": "podcaster"
  },
  "blobs": {
    "maxFileBytes": 4096,
    "quotaBytes": 8192,
    "mimeTypes": [
      "image/png",
      "image/gif"
    ]
  },
  "config": {
    "caption": {
      "type": "string",
      "default": "",
      "editableBy": "podcaster"
    }
  }
}
