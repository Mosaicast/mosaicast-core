{
  "id": "nopage",
  "version": "1.0.0",
  "platformApi": "0.16.0",
  "name": "No Page Fixture",
  "backend": {
    "basePath": "/api/plugins/nopage",
    "extensions": [
      "dev.mosaicast.plugin.fixture.FixturePlugin"
    ]
  },
  "frontend": {
    "entry": "fixture.js",
    "elements": [
      "fixture-card"
    ]
  },
  "slots": [
    {
      "scope": "episode",
      "element": "fixture-card",
      "placement": "main",
      "visibleTo": "anonymous",
      "order": 100
    }
  ],
  "storage": "doc",
  "data": {
    "readableBy": "anonymous",
    "writableBy": "podcaster"
  },
  "config": {}
}
