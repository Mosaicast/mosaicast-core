# Copy to .env (in the core repo root) and fill in. Do NOT commit .env.

# --- Database ---
POSTGRES_DB=mosaicast
POSTGRES_USER=mosaicast
POSTGRES_PASSWORD=change-me

# --- App ---
APP_PORT=8080
MOSAICAST_BASE_URL=http://localhost:8080
# Plugins folder. In Docker mounted to /app/plugins via a volume (see compose).
# Locally without Docker: a path of your choice, default ./plugins.
MOSAICAST_PLUGINS_DIR=./plugins

# --- Auth: Discord OAuth (v1) ---
# Discord Developer Portal -> Application -> OAuth2.
# Add the redirect URI: http://localhost:8080/login/oauth2/code/discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# --- Bootstrap admin (first start) ---
# Provider + your external ID at that provider. The first login with it becomes ADMIN.
# Discord user ID: enable Developer Mode in Discord -> right-click yourself -> "Copy ID".
ADMIN_BOOTSTRAP_PROVIDER=discord
ADMIN_BOOTSTRAP_EXTERNAL_ID=

# --- Token encryption (for stored OAuth/creator tokens, from v2) ---
# 32-byte key as base64. Setting it now does no harm.
# generate e.g.: openssl rand -base64 32
MOSAICAST_ENCRYPTION_KEY=

# --- GitHub Packages (needed only to BUILD the backend image) ---
# The plugin SDK's Java artifacts live in GitHub Packages, which requires authentication even for
# public reads. `docker compose build` passes these to the Gradle step as BuildKit secrets (never baked
# into the image). Create a Personal Access Token with the `read:packages` scope.
# Not needed at runtime, and not needed at all once the SDK is on Maven Central.
GITHUB_ACTOR=
GITHUB_TOKEN=
