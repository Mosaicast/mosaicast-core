# Copy to .env (in the core repo root) and fill in. Do NOT commit .env.

# --- Database ---
POSTGRES_DB=mosaicast
POSTGRES_USER=mosaicast
POSTGRES_PASSWORD=change-me

# --- App ---
APP_PORT=8080
MOSAICAST_BASE_URL=http://localhost:8080
# Plugins folder. In Docker mounted to /app/plugins via a volume (see compose).
# Locally without Docker: a path of your choice, default ./plugins.
MOSAICAST_PLUGINS_DIR=./plugins

# Extra language catalogs, read at runtime (ARCHITECTURE §12.7). Drop `nl.json` in here and Dutch appears on
# /admin/languages, ready to be switched on — no rebuild. A file named after a language that already ships
# overrides only the keys it declares, which is how you rename "Podcast" to "Show" without forking a catalog.
# Unset means "shipped languages only".
MOSAICAST_LOCALES_DIR=./locales

# Plugins to install at startup — comma-separated, resolved before the app boots (plugins are read once,
# at startup, so a plugin arriving later stays invisible until the next restart).
#
#   owner/repo                          the latest release
#   owner/repo@v1.2.3                   that release
#   owner/repo@v1.2.3#sha256:abc123…    that release, verified   <-- prefer this form
#   https://…/plugin.tgz[#sha256:…]     a tarball anywhere
#
# A plugin is trusted, in-process, unsandboxed code (ARCHITECTURE §7.1). Installing one is now an env var
# away, so pin a tag AND a checksum: it is the only integrity control this model offers, and an unpinned
# spec means whatever that repo publishes next runs inside your server.
#
# An unresolvable spec fails the container rather than booting without the plugin — a healthy-looking
# instance silently missing something you asked for is the worse outcome.
#
# In the container only prebuilt release tarballs work (no git or JDK in the runtime image). On a dev
# machine, `scripts/install-plugin.sh` additionally falls back to cloning and running the plugin's build.sh.
MOSAICAST_PLUGINS=
# Re-install every spec on each start instead of leaving what is already there (useful when a tag moves).
MOSAICAST_PLUGINS_REPLACE=false

# --- Auth: Discord OAuth (v1) ---
# Discord Developer Portal -> Application -> OAuth2.
# Add the redirect URI matching how you reach the app: <MOSAICAST_BASE_URL>/login/oauth2/code/discord
# e.g. http://localhost:8080/login/oauth2/code/discord (local) or https://yourdomain/login/oauth2/code/discord.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# The session cookie is marked Secure by default, so social login needs a secure context: HTTPS, or
# http://localhost (browsers special-case it). Over plain http on a LAN IP / hostname the browser drops the
# cookie and login fails with `authorization_request_not_found`. Serve behind TLS in production; for a
# plain-http local run set this to false. Never false on a real (non-localhost, non-TLS) deployment.
MOSAICAST_SECURITY_SECURE_COOKIE=true

# --- Bootstrap admin (first start) ---
# Provider + your external ID at that provider. The first login with it becomes ADMIN.
# Discord user ID: enable Developer Mode in Discord -> right-click yourself -> "Copy ID".
ADMIN_BOOTSTRAP_PROVIDER=discord
ADMIN_BOOTSTRAP_EXTERNAL_ID=

# --- External services (Admin -> External services) ---
# Providers normally reach public addresses only. A SELF-HOSTED service — LibreTranslate on your own
# network — is a private address, and the SSRF filter refuses those by default. List the exact origins you
# want to permit, comma-separated: scheme, host and port all match literally.
#
#   MOSAICAST_EXTERNAL_ALLOWED_PRIVATE_ORIGINS=http://libretranslate:5000
#
# This is NOT the same as mosaicast.feed.allow-private-targets, and deliberately so: that one disables the
# whole filter on the feed path. Naming one origin here permits one service on one port and nothing else.
MOSAICAST_EXTERNAL_ALLOWED_PRIVATE_ORIGINS=

# Provider credentials, when a provider needs one. Derived per kind and provider:
#   MOSAICAST_EXTERNAL_<KIND>_<PROVIDER>_<SUFFIX>
# e.g. a LibreTranslate instance running with API keys enabled:
#   MOSAICAST_EXTERNAL_TRANSLATION_LIBRETRANSLATE_API_KEY=...
# Optional: a default self-hosted LibreTranslate runs with keyRequired:false and needs none. Preferred over
# typing the key into the admin page, where it is stored in the database and lands in backups.

# --- Reverse proxy ---
# Whether X-Forwarded-* headers are believed, and from whom. The app needs them behind a TLS terminator to
# build correct absolute URLs — notably the OAuth2 redirect URI — but whoever is believed can also choose
# the address the rate limiter keys on, which is the login and token budget.
#
# The default (`native`) has Tomcat rewrite the client address only for a peer inside MOSAICAST_TRUSTED_PROXIES,
# so a proxy on the compose network is honoured and an internet client that sets the header itself is not.
# It used to be `framework`, which believes the headers whoever sent them: with the shipped compose
# publishing the app port directly, any caller could rotate X-Forwarded-For for a fresh budget on every
# request — or pin a victim's address at 429 and keep them from logging in.
#
# Narrow the range to the proxy's own address wherever you know it. The default is Tomcat's own list of
# private ranges, which is right for a container network and too generous for a host on a shared LAN.
# Set the strategy to `none` if nothing fronts this app.
MOSAICAST_FORWARD_HEADERS_STRATEGY=native
# Left commented rather than set empty: an empty value would override the default with "trust nobody",
# which silently breaks every deployment that does have a proxy in front of it.
#MOSAICAST_TRUSTED_PROXIES=172.18.0.0/16

# --- Credential encryption at rest ---
# 32-byte key as base64. Used for admin-entered external-service credentials (Admin → External services)
# and reserved for stored OAuth/creator tokens. Unset means those values are stored in PLAIN TEXT and will
# appear in database backups — the app starts either way and warns once at boot.
# Prefer supplying provider credentials through MOSAICAST_EXTERNAL_* variables instead, where there is
# nothing stored to encrypt in the first place.
# generate e.g.: openssl rand -base64 32
MOSAICAST_ENCRYPTION_KEY=

# --- GitHub Packages (needed only to BUILD the backend image) ---
# The plugin SDK's Java artifacts live in GitHub Packages, which requires authentication even for
# public reads. `docker compose build` passes these to the Gradle step as BuildKit secrets (never baked
# into the image). Create a Personal Access Token with the `read:packages` scope.
# Not needed at runtime, and not needed at all once the SDK is on Maven Central.
GITHUB_ACTOR=
GITHUB_TOKEN=
