{
  "name": "@mosaicast/core-shell",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Mosaicast host shell (React/Vite). Serves the SPA and mounts Web Component plugins via ctx.",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "dev": "vite",
    "icons": "node dev/gen-icons.mjs",
    "attributions": "node dev/gen-attributions.mjs",
    "build": "tsc --noEmit && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@mosaicast/plugin-sdk": "^0.15.0",
    "dompurify": "^3.4.11",
    "i18next": "^24.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.4.0",
    "react-router-dom": "^7.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.9",
    "bootstrap-icons": "^1.13.1",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.70.1",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
